{
  "expo": {
    "name": "M.A.B. S1 Path Editor",
    "slug": "mab-s1-path-editor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "scheme": "mabs1patheditor",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mabs1patheditor.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Select sketches for CAD conversion",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "mabs1patheditor"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.mabs1patheditor.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "READ_MEDIA_IMAGES"
        
      ],
      "blockedPermissions": [
  "android.permission.CAMERA",
  "android.permission.RECORD_AUDIO"
]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "42b8ca55-3810-4eb5-b3f8-5e4b960d5e2d"
      }
    }
  }
}
